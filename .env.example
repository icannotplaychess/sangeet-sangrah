# Postgres connection string (Vercel: added automatically when you create a
# Postgres database in the Storage tab — Neon, Supabase, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sangeet"

# Admin login password for /admin (required for the CMS)
ADMIN_PASSWORD="change-me"

# Optional: session-signing secret. If omitted, one is derived from ADMIN_PASSWORD.
# ADMIN_SECRET="a-long-random-string"

# Optional: Vercel Blob token for audio uploads (added automatically when you
# create a Blob store in the Vercel Storage tab)
# BLOB_READ_WRITE_TOKEN=""
